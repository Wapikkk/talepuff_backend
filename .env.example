# Koneksi PostgreSQL
DB_URL=postgres://USER:PASSWORD@localhost:5432/talepuff?sslmode=disable
# Test Database URL
TEST_DB_URL=postgres://USER:PASSWORD@localhost:5432/talepuff_test?sslmode=disable
# ID proyek Firebase
FIREBASE_PROJECT_ID=isi-dengan-id-proyek-firebase

# Totem (MQTT). Kosongkan MQTT_BROKER_URL untuk mematikan fitur totem.
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_USER=backend
MQTT_PASSWORD=isi-sandi-pengguna-backend-mosquitto
# Alamat audio yang terjangkau totem: IP laptop + port layanan AI (FastAPI, jalankan dengan --host 0.0.0.0)
AUDIO_PUBLIC_BASE_URL=http://192.168.1.5:8000
